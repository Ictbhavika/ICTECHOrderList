<div class="order-list-container">

	<mt-empty-state v-if="!orderLists || orderLists.length === 0" icon="regular-list-xs" headline="No order lists found"/> 

	<mt-card
		v-else v-for="orderList in orderLists" :key="orderList.id" class="order-list-card">

		<!-- Header -->
		<div class="order-list-card-header" @click="toggleAccordion(orderList.id)">

			<div class="order-list-left">
				<span class="order-list-name">
					{{ orderList.name }}
				</span>

				<span class="order-list-count">
					{{ orderList.products?.length || 0 }}
					Products
				</span>
			</div>

			<mt-icon name="regular-chevron-right-xs" class="order-chevron" :class="{ 'is-open': isExpanded(orderList.id) }"/>
		</div>

		<!-- Body -->
		<div v-if="isExpanded(orderList.id)" class="order-list-card-body">

			<div v-if="orderList.products?.length > 0">

				<div class="order-list-table-wrapper">
					<table class="order-list-table">
						<thead>
							<tr>
								<th>Product</th>
								<th>Product No</th>
								<th>Qty</th>
							</tr>
						</thead>
						<tbody>
							<tr v-for="product in orderList.products" :key="product.id">

								<td class="product-name">
									{{ getProductName(product) }}
								</td>

								<td>{{ product.productNumber }}</td>

								<td>
									<span class="qty-badge">
										{{ product.qty }}
									</span>
								</td>

							</tr>
						</tbody>
					</table>
				</div>

			</div>
			<mt-empty-state v-else icon="solid-shopping-bag" headline="No products found"/>
		</div>
	</mt-card>
</div>
