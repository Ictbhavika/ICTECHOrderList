{% block page_account_order_list_model_product_model %}
	<div class="modal fade" id="createOrderListModal" tabindex="-1" aria-labelledby="createOrderListLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="createOrderListLabel">
						{{ "ictectechOrderList.account.createOrderListBtn"|trans|sw_sanitize }}
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<p class="text-muted mb-4">
						{{ "ictectechOrderList.account.orderlistModelLabel"|trans|sw_sanitize }}
					</p>

					<form action="{{ path('frontend.order-list.create') }}" method="post" enctype="multipart/form-data">
						<div class="row g-3 g-md-4">
							<div class="col-12 col-md-6">
								<label class="form-label fw-semibold">
									{{ "ictectechOrderList.account.orderListName"|trans|sw_sanitize }}
									<span class="text-danger">*</span>
								</label>
								<input type="text" 
									name="orderListName" 
									class="form-control" 
									required 
									minlength="3"
									maxlength="100"
									placeholder="{{ "ictectechOrderList.account.orderListNamePlaceholder"|trans|sw_sanitize }}"
								>
							</div>

							<div class="col-12 col-md-6">
								<label class="form-label fw-semibold">
									{{ "ictectechOrderList.account.csvImport"|trans|sw_sanitize }}
								</label>
								<input type="file" name="csvFile" class="form-control" accept=".csv">
								<small class="text-muted d-block mt-1">
									<a href="{{ path('frontend.account.order-list.csv.demo') }}" class="text-decoration-none">
										{{ 'ictectechOrderList.account.csvDownloadDemo'|trans }}
									</a>
								</small>
							</div>
						</div>

						<div class="modal-footer border-0 px-0 pb-0 mt-4 flex-column flex-sm-row gap-2">
							<button type="button" class="btn btn-secondary w-100 w-sm-auto order-2 order-sm-1" data-bs-dismiss="modal">{{ "ictectechOrderList.account.modal.cancel"|trans|sw_sanitize }}</button>
							<button type="submit" class="btn btn-primary w-100 w-sm-auto order-1 order-sm-2">{{ "ictectechOrderList.account.createOrderListBtn"|trans|sw_sanitize }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
