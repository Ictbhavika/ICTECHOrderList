{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %} 

{% block base_flashbags %}
	<div data-flash-message>
		{{ parent() }}
	</div>
{% endblock %}

{% block page_account_main_content %}

	{% block page_account_order_list %}
		<div
			class="order-list-page" data-order-list-modals>
			<!-- Header -->
			<div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center mb-4 gap-3">
				<h1 class="h2 mb-0">
					{{ "ictectechOrderList.account.orderListOverview"|trans|sw_sanitize }}
				</h1>

				<div
					class="d-flex flex-column flex-sm-row gap-2">
					<!-- Create Button -->
					<button class="btn btn-primary w-100 w-sm-auto" data-bs-toggle="modal" data-bs-target="#createOrderListModal">
						{% sw_icon 'plus' style { size: 'sm', pack: 'solid' } %}
						<span class="d-none d-sm-inline">{{ "ictectechOrderList.account.createOrderListBtn"|trans|sw_sanitize }}</span>
					</button>
				</div>
			</div>

			{% if orderLists.total > 0 %}
				<div
					class="row mb-4 g-3">
					<!-- Search -->
					<div class="col-12 col-md-4" data-order-list-search>
						<input type="text" class="form-control" placeholder="Search lists..." data-search-input>
					</div>

					<!-- View Toggle -->
					<div class="col-12 col-md-8 d-flex gap-2 justify-content-md-end">
						<button type="button" class="btn btn-sm btn-outline-secondary" data-view-mode="grid" title="Grid view" data-order-list-view-switcher>
							<svg width="16" height="16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/></svg>
						</button>
						<button type="button" class="btn btn-sm btn-outline-secondary" data-view-mode="list" title="List view" data-order-list-view-switcher>
							<svg width="16" height="16" fill="currentColor"><path d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/></svg>
						</button>
					</div>
				</div>
			{% endif %}

			{# EMPTY STATE #}
			{% if orderLists.total == 0 %}
				<div class="card border-0 shadow-sm">
					<div class="card-body text-center py-5">
						<h4 class="mb-2 mt-3">{{ "ictectechOrderList.account.emptyState.title"|trans|sw_sanitize }}</h4>
						<p class="text-muted mb-4">{{ "ictectechOrderList.account.emptyState.description"|trans|sw_sanitize }}</p>
						<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createOrderListModal">
							{% sw_icon 'plus' style { size: 'sm', pack: 'solid' } %}
							{{ "ictectechOrderList.account.emptyState.button"|trans|sw_sanitize }}
						</button>
					</div>
				</div>
				
			{% else %}

				<!-- GRID -->
				<div class="order-list-container view-grid" data-order-list-container>

					{% for orderList in orderLists %}
						<div class="order-item" data-search-item>
							<div class="order-list-card">
								<div class="order-list-header">
								
									{% set displayName = '' %}
									{% set currentLanguageId = app.request.attributes.get('sw-sales-channel-context').context.languageId %}
									{% if orderList.translations %}
										{% for translation in orderList.translations %}
											{% if translation.languageId == currentLanguageId %}
												{% set displayName = translation.name %}
											{% endif %}
										{% endfor %}
									{% endif %}
									{% if displayName == '' and orderList.translations|first %}
										{% set displayName = orderList.translations|first.name %}
									{% endif %}
									<h5 class="order-list-title">{{ displayName }}</h5>
									<span class="order-list-badge">
										{{ orderList.productCount }}
										{% if orderList.productCount == 1 %}
											{{ "ictectechOrderList.account.product"|trans|sw_sanitize }}
										{% else %}
											{{ "ictectechOrderList.account.products"|trans|sw_sanitize }}
										{% endif %}
									</span>
								</div>
								<div class="order-list-body">
									<div class="d-flex align-items-center text-muted small mb-3">
										<span class="me-2">{% sw_icon 'calendar' style { size: 'xs' } %}</span>
										<span>{{ orderList.createdAt|date('d M Y H:i') }}</span>
									</div>
									<div class="order-list-actions">
										<a href="{{ path('frontend.order-list.detail', {id: orderList.id}) }}" class="btn btn-sm btn-outline-primary flex-grow-1">
											Open
										</a>
										<div class="dropdown">
											<button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
												{% sw_icon 'more-vertical' style { size: 'xs' } %}
											</button>
											<ul class="dropdown-menu dropdown-menu-end shadow-sm">
												<li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#renameModal" data-list-id="{{ orderList.id }}" data-list-name="{{ displayName }}">Rename</a></li>
												<li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#duplicateModal" data-list-id="{{ orderList.id }}" data-list-name="{{ displayName }}">Duplicate</a></li>
												<li><hr class="dropdown-divider"></li>
												<li><a class="dropdown-item text-danger" href="#" data-bs-toggle="modal" data-bs-target="#deleteModal" data-list-id="{{ orderList.id }}" data-list-name="{{ displayName }}">Delete</a></li>
											</ul>
										</div>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}

				</div>
				
				<!-- Pagination -->
				{% if orderLists.total > 5 %}
					<div class="mt-4 d-flex justify-content-center">
						{% sw_include '@Storefront/storefront/component/pagination.html.twig' with {
							entities: orderLists
						} %}
					</div>
				{% endif %}

			{% endif %}
		</div>

		{% block page_account_order_list_model_product_add %}
			{% sw_include '@Storefront/storefront/page/account/order-list/order-list-product-model.html.twig' with {
				} only %}
		{% endblock %}

		<!-- Rename Modal -->
		<div class="modal fade" id="renameModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ "ictectechOrderList.account.modal.rename.title"|trans|sw_sanitize }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form action="{{ path('frontend.order-list.rename') }}" method="post">
						<div class="modal-body">
							<input type="hidden" name="listId" id="renameListId">
							<label for="renameListName" class="form-label">{{ "ictectechOrderList.account.modal.rename.label"|trans|sw_sanitize }}</label>
							<input type="text" class="form-control" id="renameListName" name="name" required>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ "ictectechOrderList.account.modal.cancel"|trans|sw_sanitize }}</button>
							<button type="submit" class="btn btn-primary">{{ "ictectechOrderList.account.modal.rename.submit"|trans|sw_sanitize }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- Duplicate Modal -->
		<div class="modal fade" id="duplicateModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ "ictectechOrderList.account.modal.duplicate.title"|trans|sw_sanitize }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form action="{{ path('frontend.order-list.duplicate') }}" method="post">
						<div class="modal-body">
							<input type="hidden" name="listId" id="duplicateListId">
							<label for="duplicateListName" class="form-label">{{ "ictectechOrderList.account.modal.duplicate.label"|trans|sw_sanitize }}</label>
							<input type="text" class="form-control" id="duplicateListName" name="name" required>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ "ictectechOrderList.account.modal.cancel"|trans|sw_sanitize }}</button>
							<button type="submit" class="btn btn-primary">{{ "ictectechOrderList.account.modal.duplicate.submit"|trans|sw_sanitize }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- Delete Modal -->
		<div class="modal fade" id="deleteModal" tabindex="-1">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">{{ "ictectechOrderList.account.modal.delete.title"|trans|sw_sanitize }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<form action="{{ path('frontend.order-list.delete') }}" method="post">
						<div class="modal-body">
							<input type="hidden" name="listId" id="deleteListId">
							<p>{{ "ictectechOrderList.account.modal.delete.message"|trans|sw_sanitize }}
								<strong id="deleteListName"></strong>?</p>
							<p class="text-muted small">{{ "ictectechOrderList.account.modal.delete.warning"|trans|sw_sanitize }}</p>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ "ictectechOrderList.account.modal.cancel"|trans|sw_sanitize }}</button>
							<button type="submit" class="btn btn-danger">{{ "ictectechOrderList.account.modal.delete.submit"|trans|sw_sanitize }}</button>
						</div>
					</form>
				</div>
			</div>
		</div>

	</div>

{% endblock %}{% endblock %}
