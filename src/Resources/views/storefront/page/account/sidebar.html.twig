{% sw_extends '@Storefront/storefront/page/account/sidebar.html.twig' %}

{% block page_account_sidebar_link_orders %}
    {% set checkActive = config("ICTECHOrderList.config.active") %}
    
    {% if checkActive %}
        <a href="{{ path('frontend.account.order-list.page') }}"
           title="{{ "ictectechOrderList.account.sidebarLink"|trans|striptags }}"
           class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.account.order-list.page') %} is-active{% endif %}">
            {{ "ictectechOrderList.account.pageTitle"|trans|sw_sanitize }}
        </a>
    {% endif %}
    {{ parent() }}
{% endblock %}
