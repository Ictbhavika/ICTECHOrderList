{
    "name": "i-c-t-e-c-h-order-list/i-c-t-e-c-h-order-list",
    "description": "i-c-t-e-c-h-order-list/i-c-t-e-c-h-order-list",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "ICTECHOrderList\\ICTECHOrderList",
        "label": {
            "de-DE": "Bestelliste",
            "en-GB": "Order List"
        }
    },
    "autoload": {
        "psr-4": {
            "ICTECHOrderList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ICTECHOrderList\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "nunomaduro/phpinsights": "^2.13"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
